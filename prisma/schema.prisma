// Vaony — data model. SQLite in dev (no native enums: role/status fields are
// validated strings constrained by Zod at the API boundary).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         String   @default("STUDENT") // ADMIN | STUDENT | TEACHER
  firstName    String
  lastName     String
  avatarUrl    String?
  phone        String?
  timezone     String   @default("America/Mexico_City")
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  teacherProfile     TeacherProfile?
  enrollments        Enrollment[]         @relation("StudentEnrollments")
  teacherEnrollments Enrollment[]         @relation("TeacherEnrollments")
  studentBookings    Booking[]            @relation("StudentBookings")
  teacherBookings    Booking[]            @relation("TeacherBookings")
  availabilitySlots  AvailabilitySlot[]
  blockedTimes       BlockedTime[]
  payments           Payment[]
  reviewsGiven       Review[]             @relation("ReviewAuthor")
  reviewsReceived    Review[]             @relation("ReviewTarget")
  studentConvos      Conversation[]       @relation("StudentConvos")
  teacherConvos      Conversation[]       @relation("TeacherConvos")
  messages           Message[]
  materialsUploaded  Material[]           @relation("MaterialUploader")
  materialsReceived  Material[]           @relation("MaterialStudent")
  notifications      Notification[]
  packagePurchases   PackagePurchase[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeacherProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String? // e.g. "M.Sc. Mechanical Engineering"
  specialization String?
  bio            String?
  languages      String  @default("English") // comma-separated
  ratingAvg      Float   @default(0)
  ratingCount    Int     @default(0)
  linkedinUrl    String?
  githubUrl      String?
  websiteUrl     String?
  featured       Boolean @default(false)

  credentials    Credential[]
  portfolioItems PortfolioItem[]
  softwareTags   TeacherSoftwareTag[]
  courses        CourseTeacher[]
}

model Credential {
  id          String         @id @default(cuid())
  profileId   String
  profile     TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  institution String
  fileUrl     String?
  createdAt   DateTime       @default(now())
}

model PortfolioItem {
  id        String         @id @default(cuid())
  profileId String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  type      String // IMAGE | PDF | LINK
  url       String
  createdAt DateTime       @default(now())
}

model SoftwareTag {
  id       String               @id @default(cuid())
  name     String               @unique
  teachers TeacherSoftwareTag[]
}

model TeacherSoftwareTag {
  profileId String
  tagId     String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       SoftwareTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  order   Int      @default(0)
  courses Course[]
}

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  shortDesc       String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  level           String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  durationMinutes Int      @default(60)
  price           Float
  currency        String   @default("USD")
  published       Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())

  teachers    CourseTeacher[]
  enrollments Enrollment[]
  bookings    Booking[]
  materials   Material[]
}

model CourseTeacher {
  courseId  String
  profileId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([courseId, profileId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherEnrollments", fields: [teacherId], references: [id])
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  progress  Int      @default(0) // 0-100
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model AvailabilitySlot {
  id        String @id @default(cuid())
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Sunday … 6 = Saturday (in teacher's timezone)
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
}

model BlockedTime {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
}

model Booking {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation("StudentBookings", fields: [studentId], references: [id])
  teacherId  String
  teacher    User     @relation("TeacherBookings", fields: [teacherId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  startsAt   DateTime // UTC
  endsAt     DateTime // UTC
  status     String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED | RESCHEDULED
  meetingUrl String?
  notes      String?
  reminder24Sent Boolean @default(false)
  reminder1Sent  Boolean @default(false)
  createdAt  DateTime @default(now())

  payment Payment?
  review  Review?
}

model SessionPackage {
  id          String  @id @default(cuid())
  name        String
  sessions    Int
  price       Float
  currency    String  @default("USD")
  discountPct Int     @default(0)
  active      Boolean @default(true)

  purchases PackagePurchase[]
}

model PackagePurchase {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  packageId        String
  package          SessionPackage @relation(fields: [packageId], references: [id])
  sessionsLeft     Int
  createdAt        DateTime       @default(now())
  payment          Payment?
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  bookingId   String?  @unique
  booking     Booking? @relation(fields: [bookingId], references: [id])
  purchaseId  String?  @unique
  purchase    PackagePurchase? @relation(fields: [purchaseId], references: [id])
  provider    String // STRIPE | PAYPAL | MERCADOPAGO
  providerRef String?
  amount      Float
  currency    String   @default("USD")
  status      String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  studentId String
  student   User     @relation("ReviewAuthor", fields: [studentId], references: [id])
  teacherId String
  teacher   User     @relation("ReviewTarget", fields: [teacherId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentConvos", fields: [studentId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherConvos", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([studentId, teacherId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  fileUrl        String?
  fileName       String?
  fileType       String?
  sentAt         DateTime     @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  flagged        Boolean      @default(false)
  deleted        Boolean      @default(false)
}

model Material {
  id         String   @id @default(cuid())
  uploaderId String
  uploader   User     @relation("MaterialUploader", fields: [uploaderId], references: [id])
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id])
  studentId  String?
  student    User?    @relation("MaterialStudent", fields: [studentId], references: [id])
  title      String
  fileUrl    String
  fileType   String
  sizeBytes  Int      @default(0)
  createdAt  DateTime @default(now())
}

model TeacherApplication {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  specialization  String
  yearsExperience Int
  bio             String
  cvUrl           String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  mediaUrl  String
  type      String   @default("IMAGE") // IMAGE | VIDEO | PDF
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // BOOKING | MESSAGE | PAYMENT | SYSTEM
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
