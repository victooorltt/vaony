generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String?
  googleId           String?            @unique
  role               String             @default("STUDENT")
  firstName          String
  lastName           String
  avatarUrl          String?
  phone              String?
  timezone           String             @default("America/Mexico_City")
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  availabilitySlots  AvailabilitySlot[]
  blockedTimes       BlockedTime[]
  studentBookings    Booking[]          @relation("StudentBookings")
  teacherBookings    Booking[]          @relation("TeacherBookings")
  studentConvos      Conversation[]     @relation("StudentConvos")
  teacherConvos      Conversation[]     @relation("TeacherConvos")
  enrollments        Enrollment[]       @relation("StudentEnrollments")
  teacherEnrollments Enrollment[]       @relation("TeacherEnrollments")
  materialsReceived  Material[]         @relation("MaterialStudent")
  materialsUploaded  Material[]         @relation("MaterialUploader")
  messages           Message[]
  notifications      Notification[]
  packagePurchases   PackagePurchase[]
  passwordResets     PasswordReset[]
  payments           Payment[]
  refreshTokens      RefreshToken[]
  reviewsGiven       Review[]           @relation("ReviewAuthor")
  reviewsReceived    Review[]           @relation("ReviewTarget")
  teacherProfile     TeacherProfile?
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  title          String?
  specialization String?
  bio            String?
  languages      String               @default("English")
  ratingAvg      Float                @default(0)
  ratingCount    Int                  @default(0)
  linkedinUrl    String?
  githubUrl      String?
  websiteUrl     String?
  featured       Boolean              @default(false)
  courses        CourseTeacher[]
  credentials    Credential[]
  portfolioItems PortfolioItem[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  softwareTags   TeacherSoftwareTag[]
}

model Credential {
  id          String         @id @default(cuid())
  profileId   String
  title       String
  institution String
  fileUrl     String?
  createdAt   DateTime       @default(now())
  profile     TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id        String         @id @default(cuid())
  profileId String
  title     String
  type      String
  url       String
  createdAt DateTime       @default(now())
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SoftwareTag {
  id       String               @id @default(cuid())
  name     String               @unique
  teachers TeacherSoftwareTag[]
}

model TeacherSoftwareTag {
  profileId String
  tagId     String
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       SoftwareTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  order   Int      @default(0)
  courses Course[]
}

model Course {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String
  shortDesc       String
  categoryId      String
  level           String          @default("BEGINNER")
  durationMinutes Int             @default(60)
  price           Float
  currency        String          @default("USD")
  published       Boolean         @default(true)
  featured        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  bookings        Booking[]
  category        Category        @relation(fields: [categoryId], references: [id])
  teachers        CourseTeacher[]
  enrollments     Enrollment[]
  materials       Material[]
}

model CourseTeacher {
  courseId  String
  profileId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([courseId, profileId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  teacherId String
  status    String   @default("ACTIVE")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User     @relation("TeacherEnrollments", fields: [teacherId], references: [id])

  @@unique([studentId, courseId])
}

model AvailabilitySlot {
  id        String @id @default(cuid())
  teacherId String
  weekday   Int
  startTime String
  endTime   String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model BlockedTime {
  id        String   @id @default(cuid())
  teacherId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String   @id @default(cuid())
  studentId      String
  teacherId      String
  courseId       String
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("PENDING")
  meetingUrl     String?
  notes          String?
  reminder24Sent Boolean  @default(false)
  reminder1Sent  Boolean  @default(false)
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id])
  student        User     @relation("StudentBookings", fields: [studentId], references: [id])
  teacher        User     @relation("TeacherBookings", fields: [teacherId], references: [id])
  payment        Payment?
  review         Review?
}

model SessionPackage {
  id          String            @id @default(cuid())
  name        String
  sessions    Int
  price       Float
  currency    String            @default("USD")
  discountPct Int               @default(0)
  active      Boolean           @default(true)
  purchases   PackagePurchase[]
}

model PackagePurchase {
  id           String         @id @default(cuid())
  userId       String
  packageId    String
  sessionsLeft Int
  createdAt    DateTime       @default(now())
  package      SessionPackage @relation(fields: [packageId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  payment      Payment?
}

model Payment {
  id          String           @id @default(cuid())
  userId      String
  bookingId   String?          @unique
  purchaseId  String?          @unique
  provider    String
  providerRef String?
  amount      Float
  currency    String           @default("USD")
  status      String           @default("PENDING")
  receiptUrl  String?
  createdAt   DateTime         @default(now())
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  purchase    PackagePurchase? @relation(fields: [purchaseId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  studentId String
  teacherId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  student   User     @relation("ReviewAuthor", fields: [studentId], references: [id])
  teacher   User     @relation("ReviewTarget", fields: [teacherId], references: [id])
}

model Conversation {
  id        String    @id @default(cuid())
  studentId String
  teacherId String
  createdAt DateTime  @default(now())
  student   User      @relation("StudentConvos", fields: [studentId], references: [id])
  teacher   User      @relation("TeacherConvos", fields: [teacherId], references: [id])
  messages  Message[]

  @@unique([studentId, teacherId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  fileUrl        String?
  fileName       String?
  fileType       String?
  sentAt         DateTime     @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  flagged        Boolean      @default(false)
  deleted        Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model Material {
  id         String   @id @default(cuid())
  uploaderId String
  courseId   String?
  studentId  String?
  title      String
  fileUrl    String
  fileType   String
  sizeBytes  Int      @default(0)
  createdAt  DateTime @default(now())
  course     Course?  @relation(fields: [courseId], references: [id])
  student    User?    @relation("MaterialStudent", fields: [studentId], references: [id])
  uploader   User     @relation("MaterialUploader", fields: [uploaderId], references: [id])
}

model TeacherApplication {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  specialization  String
  yearsExperience Int
  bio             String
  cvUrl           String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  mediaUrl  String
  type      String   @default("IMAGE")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
